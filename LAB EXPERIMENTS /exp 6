import numpy as np

# Runtime input for quarterly sales
sales_data = []

print("Enter sales for each quarter:")

for i in range(4):
    sales = float(input(f"Enter sales for Q{i + 1}: "))
    sales_data.append(sales)

# Convert list to NumPy array
sales_data = np.array(sales_data)

# Calculate total sales
total_sales = np.sum(sales_data)

# Calculate percentage increase from Q1 to Q4
percentage_increase = ((sales_data[3] - sales_data[0]) / sales_data[0]) * 100

# Display the results
print("\nQuarterly Sales:", sales_data)
print("Total Sales for the Year:", total_sales)
print("Percentage Increase from Q1 to Q4:", percentage_increase, "%")
